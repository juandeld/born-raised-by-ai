# Born & Raised by AI - environment template. Copy to .env.local (apps/web) and fill in.
# Everything defaults to MOCK providers: the whole flow runs with no keys.
# Never commit real values. In Vercel set them per environment.

# --- Brand and legal (required in production: legalReady() blocks the site otherwise) ---
BRAND_NAME=Jinglo
LEGAL_HOLDER=
LEGAL_ADDRESS=
LEGAL_EFFECTIVE_DATE=
PRIVACY_EMAIL=privacidad@lumen-labs.co
SUPPORT_EMAIL=soporte@lumen-labs.co
PUBLIC_BASE_URL=http://localhost:3000
SPOKEN_DOMAIN=lumen-labs.co

# --- Payments: mock | polar | recurrente ---
PAYMENT_PROVIDER=mock
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# JSON map "slug:COUNTRY:variant" -> Polar product id, e.g. {"santa:MX:single":"<uuid>"}
POLAR_PRODUCT_MAP={}
# sandbox | production
POLAR_SERVER=sandbox
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
# 1 = fail instead of falling back to the mock when keys are missing (automatic on VERCEL_ENV=production)
PAYMENT_STRICT=
# 1 = allow the mock payment page in production (never for real traffic)
ALLOW_MOCK_PAYMENTS=

# --- Voice and telephony: mock | elevenlabs ; mock | twilio ---
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_ES_419=
ELEVENLABS_VOICE_ID_ES_ES=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_EN_US=
ELEVENLABS_VOICE_ID_EN_GB=
ELEVENLABS_LLM=
# Created on first sync; store them to avoid recreating agents. One per language (es-419, es-ES, en); "-" becomes "_" and upper-case.
ELEVENLABS_AGENT_ID_ES_419=
ELEVENLABS_AGENT_ID_ES_ES=
ELEVENLABS_AGENT_ID_EN=
ELEVENLABS_AGENT_ID_EN_US=
ELEVENLABS_AGENT_ID_EN_GB=
# D17 proposal (not applied): ELEVENLABS_SILENCE_END_CALL_TIMEOUT=-1 and ELEVENLABS_TURN_TIMEOUT=5; SANTA_PROMPT_VERSION=v4 after legal approval
# Shared secret the agent tools send in the x-agent-secret header
AGENT_TOOL_SECRET=
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional per-country caller id, e.g. TWILIO_FROM_MX, TWILIO_FROM_ES, TWILIO_FROM_GB, TWILIO_FROM_US
TWILIO_FROM_MX=
TWILIO_FROM_ES=
TWILIO_FROM_GB=
TWILIO_FROM_US=
# Concurrent calls cap = ElevenLabs plan (Pro: 20)
CALLS_MAX_CONCURRENCY=20
# Comma list of country codes open for sale, e.g. MX,ES
ENABLED_COUNTRIES=
# 1 = sell the bundle (2nd call is not schedulable yet: keep empty)
BUNDLE_ENABLED=

# --- Email, PDF, DB, storage ---
EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM=Lumen Labs <hola@lumen-labs.co>
PDF_RENDER_URL=
PDF_RENDER_TOKEN=
DB_PROVIDER=mock
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=santa
STORAGE_PROVIDER=mock
MOCK_DB_FILE=
MOCK_STORAGE_DIR=

# --- Analytics and jobs ---
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# 1 = use the local Inngest dev server (npx inngest-cli dev)
INNGEST_DEV=

# --- Safety, alerts, misc ---
# Random string, used to hash phone numbers for opt-out/DNC lists
PHONE_HASH_SALT=change-me
OWNER_ALERT_EMAIL=
LEGAL_ALERT_EMAIL=
ESCALATION_EMAIL=
# 1 = calls only to allow-listed test numbers
TEST_MODE=
# Optional FX overrides for refund caps and cost reports
FX_USD_PER_EUR=
FX_USD_PER_GBP=
FX_USD_PER_MXN=

# --- Real-provider test mode (H3) ---
# Header x-dev-secret for /api/dev/run-call when TELEPHONY_PROVIDER=twilio (needs ALLOW_MOCK_PAYMENTS=1 and PAYMENT_PROVIDER=mock)
DEV_RUN_SECRET=
# ELEVENLABS_AGENT_ID_ES419 is accepted as a fallback of ELEVENLABS_AGENT_ID_ES_419
