{
  "name": "lumen-labs",
  "private": true,
  "version": "0.1.0",
  "description": "Born & Raised by AI - Lumen Labs monorepo",
  "workspaces": [
    "apps/*",
    "engines/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @lumen/web",
    "build": "npm run build -w @lumen/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @lumen/web",
    "costs": "tsx scripts/costs.ts",
    "retention": "tsx scripts/retention.ts",
    "deploy:santa": "echo 'Deploy santa: pending Vercel account (see docs/arquitectura/pendientes-cuentas.md)' && exit 1",
    "legal:docs": "tsx scripts/legal-docs.ts",
    "check:functions": "tsx scripts/check-functions.ts",
    "colorear:sample": "tsx scripts/colorear-sample.ts",
    "colorear:levels": "tsx scripts/colorear-levels.ts",
    "colorear:photo-cost": "tsx scripts/colorear-photo-cost.ts",
    "polar:check": "tsx scripts/polar-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
